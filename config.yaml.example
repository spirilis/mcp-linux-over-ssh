# mcp-linux-over-ssh configuration.
#
# This one file feeds two parsers: generic-go-mcp reads server: and logging:, and this
# server reads ssh:.
#
# Nothing connects when this server starts. The ssh: block below is a template for the
# sessions an MCP client opens on demand with the start_session tool; several can be live
# at once, each an independent SSH login.

server:
  # stdio is the only mode this server supports.
  mode: stdio

  # Optional. Also accept MCP clients still on a connection-scoped protocol revision
  # (2025-11-25, 2025-06-18, 2025-03-26, 2024-11-05) alongside this server's native
  # 2026-07-28 support, via generic-go-mcp's compat.Overlay. On by default here — the
  # inverse of the library's own default — because most MCP clients as of this writing
  # (Claude Desktop, most IDEs) still speak one of those revisions; omit this block
  # entirely and compat stays on. Set enabled: false once every client that reaches this
  # server has moved to 2026-07-28.
  #
  # The one thing that does not translate across the compat boundary: MRTR (the run_bash
  # confirmation below) has no legacy equivalent, so a legacy caller gets a visible error
  # instead of the confirmation round trip. See ssh.require_confirmation.
  legacy_compat:
    enabled: true
    # How long an idle legacy client's session survives before it is swept. Empty/omitted
    # uses compat.Overlay's own 30-minute default.
    # session_ttl: 30m

logging:
  # trace | debug | info | warn | error. Logs go to stderr; stdout carries JSON-RPC.
  level: info
  # text | json
  format: text
  # Optional. Redirect logging from stderr to this path instead (opened for append,
  # created if missing). This key is read by mcp-linux-over-ssh itself, not the library.
  # file: /var/log/mcp-linux-over-ssh.log

ssh:
  # The command that opens a session, run via `sh -c`. Each session runs it exactly once
  # and keeps that shell for as long as the session lives; it is never re-run per tool
  # call, which is the constraint this whole server is built around. Use -tt to force a
  # TTY: the shell only prints a prompt when it thinks it is interactive, and prompt
  # detection is what frames the session.
  #
  # This is a Go text/template, rendered per session against the values start_session was
  # called with (see parameters: below). Declare no parameters and it is simply a constant.
  #
  # SECURITY: this string is handed to `sh -c` on the machine running this server, not on
  # the bastion. What a parameter is allowed to interpolate into it is therefore the
  # difference between choosing a target and choosing a command — see pattern: below.
  command: "ssh -tt {{.user}}@{{.host}}"

  # Go (RE2) regex matching the remote shell's prompt. It frames login and backstops
  # recovery. Getting this wrong is the most common failure: the session then starts in
  # the awaiting_prompt state rather than dying, so read that session's
  # mcp+stdio:///session/<id>/transcript resource and repair it with the tune_prompt_regex
  # tool. Output is stripped of ANSI escapes and CRLF-normalised before matching, so
  # write the pattern against the text a human would see.
  #
  # Also a template, so a prompt that embeds the target's own hostname or username can be
  # matched exactly. A templated pattern can only be compiled once rendered, so a broken
  # one surfaces as a start_session error rather than at startup; with no parameters
  # declared it is still checked when the config loads.
  prompt_regex: '(?m)^\[{{.user}}@[^\]]+\][$#]\s*$'

  # The values start_session accepts. Each becomes a required, described property on
  # start_session's generated input schema, so a client sees them in tools/list without a
  # separate discovery call. Omit this block entirely for a single fixed target.
  parameters:
    - parameter: host
      description: "Hostname of the bastion to connect through"
      # Go (RE2) regex every supplied value must match in full. Omitted means
      # ^[A-Za-z0-9._@:/+-]{1,256}$ — hostnames, usernames, IPs, paths and ports, and
      # nothing that carries meaning to a shell.
      #
      # Keep this tight. These values come from an MCP client rather than from you, and
      # they are interpolated into command: above, which runs locally. If you genuinely
      # need to accept spaces or metacharacters, widen the pattern AND wrap the reference
      # in shquote, which renders a value as a single safely-quoted shell word:
      #     command: "ssh -tt {{.user}}@{{.host}} -- {{shquote .remote_arg}}"
      # Use it bare, never inside quotes of your own — it supplies its own.
    - parameter: user
      description: "PSM-crafted username encoding the target system"
      pattern: '^[a-z][a-z0-9_-]{0,63}$'

  # How many sessions may be open at once. start_session refuses past this. Sessions that
  # have died do not count, so an unreachable target cannot wedge the server.
  max_sessions: 8

  # Close sessions that have gone this long without running a command. Omitted (or 0s)
  # never reaps, which is the default: on a PAM/PSM bastion, tearing down a privileged
  # session someone is still reasoning about is worse than keeping an idle one, and a
  # stdio server's sessions are already bounded by the life of its client. A session
  # running a command, or still logging in, is never reaped regardless.
  #
  # Like every duration here it must be written as a string with a unit — 30m, not 30.
  # idle_timeout: 30m

  # How long to wait for the first prompt after the command starts. Allow for banners,
  # MFA, and whatever dispatching the bastion does.
  login_timeout: 60s

  # Per-command ceiling. On expiry the command is interrupted and the session is
  # resynchronised so the next caller is not handed a stream mid-command.
  command_timeout: 300s

  # How long resynchronisation itself may take after an interrupt.
  recovery_timeout: 15s

  # TERM for the child. "dumb" keeps most shells from emitting colour and cursor motion.
  # Raise to vt100/xterm only if the bastion misbehaves without it.
  term: dumb

  # PTY dimensions. A wide terminal keeps long command lines from hard-wrapping.
  cols: 500
  rows: 24

  # Run in each session after login, before it is declared ready. `stty -echo` is the
  # clean fix for command echo; output framing tolerates echo either way.
  init_commands:
    - "stty -echo"
    - "unset PROMPT_COMMAND"

  # Wrap each command with an end marker carrying $?, giving exact framing and a real
  # exit code. Support is probed once per session during its login; a shell that cannot do
  # it falls back to prompt-only framing automatically, for that session alone. Set false
  # to skip the probe entirely.
  use_sentinel: true

  # Cap on returned output. The command is still consumed in full — only what is handed
  # back is shortened, keeping the head and the tail.
  max_output_bytes: 1048576

  # Raw bytes retained for the transcript resource. Set to -1 to disable recording.
  # WARNING: the transcript is verbatim terminal output and may contain secrets that were
  # printed to the shell.
  transcript_bytes: 262144

  # Permit re-running `command` once if the session dies and cannot be resynchronised.
  # Off by default: on a PAM/PSM bastion a reconnect is a new audited session, not a
  # retry.
  allow_reconnect: false

  # Require the caller to confirm each command via an MRTR elicitation before it runs.
  # With this on, clients that do not declare the elicitation capability cannot use
  # run_bash at all. Left unset (comment this out), the default tracks
  # server.legacy_compat.enabled above: false while compat is on, since a legacy client
  # has no way to answer the confirmation round trip and would otherwise be unable to use
  # run_bash at all; true otherwise, unchanged from before compat existed. Set explicitly,
  # as below, to pin it either way regardless of compat mode.
  require_confirmation: true
